# The Linux test environment used to validate Jarvis locally (docker build --platform …).
# The same packages are installed on the GitHub Actions Ubuntu runners (.github/workflows/ci.yml).
FROM node:22-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-utils dbus-x11 at-spi2-core python3-gi gir1.2-atspi-2.0 gir1.2-gtk-3.0 libgtk-3-0 \
      gir1.2-ayatanaappindicator3-0.1 openbox wmctrl xdotool imagemagick scrot \
      pulseaudio pulseaudio-utils alsa-utils espeak-ng bzip2 xdg-utils \
    && rm -rf /var/lib/apt/lists/*
USER node
WORKDIR /home/node/jarvis
